---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { getCollection, render } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import ChapterIndex from '../components/ChapterIndex.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { chapterCovers } from '../utils/chapter-covers';

type Heading = {
	depth: number;
	slug: string;
	text: string;
};

type Props = CollectionEntry<'blog'>['data'] & {
	headings?: Heading[];
	postId?: string;
	readingMinutes?: number;
};

const { title, description, heroImage, heroImages, headings = [], postId, readingMinutes } = Astro.props;
const heroList = (Array.isArray(heroImages) ? heroImages : heroImage ? [heroImage] : []).filter(Boolean);
const allPosts = (await getCollection('blog'))
	.filter(({ id }) => /^\d+-avventura$/.test(id))
	.sort((a, b) => parseInt(a.id) - parseInt(b.id));
const currentIndex = allPosts.findIndex((p) => p.id === postId);
const prev = currentIndex > 0 ? allPosts[currentIndex - 1] : null;
const next = currentIndex >= 0 && currentIndex < allPosts.length - 1 ? allPosts[currentIndex + 1] : null;
const isBlogPost = currentIndex >= 0;
const primaryHeading = headings.find((heading) => heading.depth === 1);
const firstSectionHeading = headings.find((heading) => heading.depth === 2);
const promotedHeading = primaryHeading ?? firstSectionHeading;
const narrativeTitle = promotedHeading?.text ?? title;
const sectionHeadings = headings.filter(
	(heading) => heading.slug !== promotedHeading?.slug && heading.depth <= 3
);
const contentClass = [
	'article-content',
	promotedHeading?.depth === 1 ? 'hide-first-h1' : '',
	promotedHeading?.depth === 2 ? 'hide-first-h2' : '',
]
	.filter(Boolean)
	.join(' ');
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const chapterCover = postId && chapterCovers[postId];
const nextCover = next && chapterCovers[next.id];
const nextHeadings = next ? (await render(next)).headings : [];
const nextTitle = nextHeadings.find(({ depth }) => depth === 1)?.text
	?? nextHeadings.find(({ depth }) => depth === 2)?.text ?? next?.data.title;
---

<html lang="it">
	<head>
		<BaseHead title={narrativeTitle} description={description} type={isBlogPost ? 'article' : 'website'} />
		<style>
			.reading-progress {
				position: fixed;
				top: 0;
				left: 0;
				z-index: 40;
				width: 100%;
				height: 4px;
				background: transparent;
				pointer-events: none;
			}

			.reading-progress__bar {
				display: block;
				width: 0%;
				height: 100%;
				background: linear-gradient(90deg, var(--accent-dark), var(--accent));
				box-shadow: 0 0 18px rgba(var(--storm-sea-rgb), 0.35);
			}

			.article-page {
				padding: 2.2rem 0 4rem;
			}

			.article-shell {
				padding: 1.75rem;
				border: 1px solid rgba(var(--border), 0.45);
				border-radius: var(--radius);
				background: rgb(var(--paper));
				box-shadow: var(--box-shadow);
			}

			.hero-image {
				width: 100%;
				margin-bottom: 1.5rem;
			}

			.hero-image img {
				display: block;
				width: 100%;
				height: auto;
				aspect-ratio: 2 / 1;
				margin: 0 auto;
				object-fit: cover;
				border-radius: calc(var(--radius) - 6px);
				box-shadow: var(--box-shadow);
			}

			.hero-grid {
				display: grid;
				gap: 0.9rem;
			}

			.hero-grid.two {
				grid-template-columns: 1fr 1fr;
			}

			.hero-grid.two img {
				aspect-ratio: 4 / 3;
			}

			.prose {
				color: rgb(var(--gray-dark));
			}

			.article-header {
				padding: clamp(1.3rem, 3vw, 2.5rem) 0;
				margin-bottom: 1.35rem;
				text-align: left;
				border-bottom: 1px solid rgba(var(--border), 0.42);
			}

			.article-header h1 {
				margin-bottom: 0.9rem;
				font-size: clamp(2.2rem, 1.6rem + 2.65vw, 4.2rem);
				font-weight: 400;
				letter-spacing: -0.035em;
				text-wrap: balance;
			}

			.chapter-cover {
				margin: 0 0 1.25rem;
				overflow: hidden;
				border-radius: var(--radius-sm);
			}

			.chapter-cover img {
				display: block;
				width: 100%;
				height: clamp(11rem, 30vw, 23rem);
				object-fit: cover;
			}

			.reading-grid {
				display: grid;
				gap: 1.2rem;
			}

			@media (min-width: 1024px) {
				.reading-grid--indexed {
					grid-template-columns: minmax(0, 1fr) minmax(16rem, 20rem);
					gap: clamp(1.5rem, 3.5vw, 3.5rem);
				}

				.reading-grid--indexed > :global(.chapter-index) { grid-area: 1 / 2; }
				.reading-grid--indexed > .prose { grid-area: 1 / 1; }
			}

			@media (max-width: 1023px) {
				.reading-grid[data-index-ready] {
					padding-inline-end: 2rem;
					gap: 0;
				}
			}

			.reading-grid--indexed > .prose {
				width: min(100%, 43rem);
				min-width: 0;
			}

			.article-content {
				font-family: Georgia, serif;
				font-size: clamp(1.08rem, 1rem + 0.35vw, 1.23rem);
				line-height: 1.8;
				overflow-wrap: anywhere;
			}

			.article-content :global(h1),
			.article-content :global(h2) {
				margin-top: clamp(2.4rem, 5vw, 4rem);
				padding-top: clamp(0.9rem, 2vw, 1.35rem);
				border-top: 1px solid rgba(var(--border), 0.48);
				letter-spacing: -0.025em;
			}

			.article-content :global(h3) {
				margin-top: 2rem;
				color: var(--accent-dark);
			}

			.article-content :global(figure) {
				margin-block: clamp(1.6rem, 4vw, 2.8rem);
			}

			.article-content :global(img) {
				border-radius: var(--radius-sm);
			}

			.article-content :global(figcaption) {
				margin-inline: auto;
				max-width: 55ch;
				font-family: Atkinson, sans-serif;
				line-height: 1.45;
			}

			.article-kicker,
			.article-meta {
				display: flex;
				flex-wrap: wrap;
				gap: 0.35rem 0.9rem;
				margin: 0;
			}

			.article-kicker {
				margin-bottom: 0.8rem;
			}

			.article-meta {
				color: rgb(var(--gray));
				font-size: 0.94rem;
				font-weight: 700;
			}

			.article-meta span + span::before {
				content: "·";
				margin-right: 0.9rem;
				color: rgba(var(--storm-sea-rgb), 0.72);
			}

			.reader-nav {
				display: grid;
				grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
				gap: 0.75rem;
				margin: 1.4rem 0 2rem;
				padding: 0.85rem;
				border: 1px solid rgba(var(--border), 0.42);
				border-radius: var(--radius-sm);
				background: rgba(var(--storm-ivory-rgb), 0.72);
			}

			.reader-nav a {
				display: flex;
				align-items: center;
				justify-content: center;
				min-height: 3.2rem;
				padding: 0.7rem 0.9rem;
				border-radius: calc(var(--radius-sm) - 6px);
				color: rgb(var(--black));
				text-align: center;
				text-decoration: none;
				font-weight: 700;
			}

			.reader-nav a:hover {
				background: rgba(var(--storm-mist-rgb), 0.14);
				color: var(--accent-dark);
			}

			.reader-nav .index {
				border-inline: 1px solid rgba(var(--border), 0.42);
				border-radius: 0;
			}

			.reader-nav .nav-label {
				display: none;
			}

			.article-content :global(.section-anchor) {
				scroll-margin-top: calc(var(--header-height) + 1.25rem);
			}

			.article-content :global(.section-anchor) {
				display: block;
			}

			.article-content :global(h1[id]:target),
			.article-content :global(h2[id]:target),
			.article-content :global(h3[id]:target) {
				color: var(--accent-dark);
			}

			.article-content.hide-first-h1 > :global(h1:first-of-type),
			.article-content.hide-first-h2 > :global(h2:first-of-type) {
				display: none;
			}

			.article-content :global(h2[id]),
			.article-content :global(h3[id]) {
				position: relative;
			}

			.article-content :global(.section-copy-link) {
				display: inline-grid;
				place-items: center;
				width: 1.8rem;
				height: 1.8rem;
				margin-left: 0.45rem;
				border: 1px solid rgba(var(--border), 0.42);
				border-radius: 999px;
				background: rgba(var(--storm-ivory-rgb), 0.78);
				color: var(--accent-dark);
				cursor: pointer;
				font: inherit;
				font-family: "Atkinson", sans-serif;
				font-size: 0.82rem;
				font-weight: 700;
				line-height: 1;
				opacity: 0;
				transform: translateY(-0.05rem);
				transition:
					opacity 0.16s ease,
					background-color 0.16s ease,
					transform 0.16s ease;
				vertical-align: middle;
			}

			.article-content :global(h2[id]:hover .section-copy-link),
			.article-content :global(h2[id]:focus-within .section-copy-link),
			.article-content :global(h3[id]:hover .section-copy-link),
			.article-content :global(h3[id]:focus-within .section-copy-link) {
				opacity: 1;
			}

			.article-content :global(.section-copy-link:hover),
			.article-content :global(.section-copy-link[data-copied="true"]) {
				background: rgba(var(--storm-mist-rgb), 0.18);
				transform: translateY(-0.12rem);
			}

			.article-content :global(.section-copy-link::before) {
				content: "#";
			}

			.article-content :global(img[role="button"]) {
				cursor: zoom-in;
				transition:
					transform 0.2s ease,
					box-shadow 0.2s ease;
			}

			.article-content :global(img[role="button"]:hover) {
				transform: translateY(-2px);
			}

			.article-content :global(img[role="button"]:focus-visible) {
				outline: 3px solid rgba(var(--storm-mist-rgb), 0.35);
				outline-offset: 4px;
			}

			.image-viewer {
				width: min(100% - 2rem, 1120px);
				max-height: min(92vh, 900px);
				padding: 0;
				border: 1px solid rgba(var(--storm-ivory-rgb), 0.28);
				border-radius: var(--radius-sm);
				background: rgba(var(--storm-night-rgb), 0.96);
				color: rgb(var(--storm-ivory-rgb));
				box-shadow: 0 28px 80px rgba(var(--storm-night-rgb), 0.42);
			}

			.image-viewer::backdrop {
				background: rgba(var(--storm-night-rgb), 0.78);
				backdrop-filter: blur(8px);
			}

			.image-viewer__inner {
				display: grid;
				gap: 0;
			}

			.image-viewer__close {
				justify-self: end;
				margin: 0.75rem 0.75rem 0;
				padding: 0.6rem 0.85rem;
				border: 1px solid rgba(var(--storm-ivory-rgb), 0.24);
				border-radius: 999px;
				background: rgba(var(--storm-ivory-rgb), 0.1);
				color: rgb(var(--storm-ivory-rgb));
				cursor: pointer;
				font-weight: 700;
			}

			.image-viewer__image {
				display: block;
				width: 100%;
				max-height: calc(92vh - 7rem);
				object-fit: contain;
				margin: 0;
				padding: 0.75rem;
				border-radius: 0;
			}

			.image-viewer__caption {
				margin: 0;
				padding: 0 1.2rem 1.1rem;
				color: rgba(var(--storm-ivory-rgb), 0.82);
				text-align: center;
				font-size: 0.95rem;
			}

			.image-viewer__caption:empty {
				display: none;
			}

			.post-nav {
				display: grid;
				gap: 1rem;
				margin-top: clamp(2.5rem, 6vw, 4.5rem);
				padding-top: 1.25rem;
				border-top: 1px solid rgba(var(--border), 0.48);
			}

			.post-nav .next {
				display: grid;
				grid-template-columns: minmax(0, 1fr) auto;
				align-items: center;
				gap: 0.8rem;
				padding: 0.85rem clamp(0.75rem, 2vw, 1.2rem);
				border: 1px solid var(--night-line);
				border-radius: var(--radius-sm);
				background: var(--midnight-raised);
				color: var(--moonlight);
				text-decoration: none;
			}

			.post-nav .next:hover { border-color: var(--gold); }
			.post-nav .next:focus-visible { outline-color: var(--gold); outline-offset: -4px; }
			.post-nav .next:hover strong { text-decoration: underline; }
			.post-nav .next .eyebrow { display: block; color: var(--gold); }
			.post-nav .next strong {
				display: block;
				font: 400 clamp(1.25rem, 1rem + 1.4vw, 2rem)/1.15 var(--display-font);
				overflow-wrap: anywhere;
			}

			.post-nav .next img {
				width: clamp(3.6rem, 12vw, 9rem);
				aspect-ratio: 4 / 3;
				object-fit: cover;
				margin: 0;
				border-radius: 0.35rem;
			}

			.post-nav .secondary-links {
				display: flex;
				flex-wrap: wrap;
				gap: 0.35rem 1.25rem;
				font-size: 0.98rem;
			}

			@media (pointer: coarse) {
				.article-content :global(.section-copy-link) {
					width: 2.75rem;
					height: 2.75rem;
					opacity: 1;
				}
			}

			@media (max-width: 720px) {
				.article-page {
					padding-top: 1.5rem;
				}

				.article-shell {
					padding: 1rem;
				}

				.prose {
					width: 100%;
				}

				.hero-grid.two {
					grid-template-columns: 1fr 1fr;
				}

				.hero-grid.two img {
					aspect-ratio: 1 / 1;
				}

				.reader-nav {
					grid-template-columns: repeat(2, minmax(0, 1fr));
					gap: 0.55rem;
					margin-bottom: 1.2rem;
					padding: 0.65rem;
				}

				.reader-nav a {
					min-width: 0;
					min-height: 2.9rem;
					padding: 0.65rem 0.7rem;
					font-size: 0.95rem;
				}

				.reader-nav .nav-label {
					display: inline;
				}

				.reader-nav .nav-title {
					display: none;
				}

				.reader-nav .index {
					grid-column: 1 / -1;
					order: -1;
					border: 0;
					border-bottom: 1px solid rgba(var(--border), 0.42);
					border-radius: 0;
				}
			}
		</style>
	</head>

	<body>
		{isBlogPost && (
			<div class="reading-progress" aria-hidden="true">
				<span class="reading-progress__bar" data-reading-progress></span>
			</div>
		)}
		<Header />
		<main id="content" tabindex="-1" class="container article-page">
			<article class="article-shell">
				{chapterCover && heroList.length === 0 && (
					<div class="chapter-cover">
						<img src={`${base}images/sessions/${chapterCover}`} alt="" decoding="auto" fetchpriority="high" />
					</div>
				)}
				{heroList.length > 0 && (
					<div class="hero-image">
						<div class={`hero-grid ${heroList.length >= 2 ? 'two' : ''}`}>
							{heroList.map((img) => (
								<Image width={1020} height={heroList.length >= 2 ? 765 : 510} src={img} alt="" />
							))}
						</div>
					</div>
				)}
				<div class:list={['reading-grid', { 'reading-grid--indexed': sectionHeadings.length > 0 }]}>
				{sectionHeadings.length > 0 && <ChapterIndex headings={sectionHeadings} />}
				<div class="prose">
					<header class="article-header">
						{isBlogPost && <p class="article-kicker"><span class="eyebrow">{title}</span></p>}
						<h1>{narrativeTitle}</h1>
						{isBlogPost && (
							<p class="article-meta">
									{readingMinutes && <span>{readingMinutes} min di lettura</span>}
								<span>{sectionHeadings.length} {sectionHeadings.length === 1 ? 'scena' : 'scene'}</span>
							</p>
						)}
					</header>
					{isBlogPost && (
						<nav class="reader-nav" aria-label="Navigazione capitolo">
							{prev ? (
								<a class="prev" href={`${base}blog/${prev.id}/`} aria-label={`Capitolo precedente: ${prev.data.title}`}>
									<span class="nav-label">← Precedente</span>
									<span class="nav-title">← {prev.data.title}</span>
								</a>
							) : <span aria-hidden="true"></span>}
							<a class="index" href={`${base}blog/`}>Tutte le avventure</a>
							{next ? (
								<a class="next" href={`${base}blog/${next.id}/`} aria-label={`Capitolo successivo: ${next.data.title}`}>
									<span class="nav-label">Successiva →</span>
									<span class="nav-title">{next.data.title} →</span>
								</a>
							) : <span aria-hidden="true"></span>}
						</nav>
					)}
					<div class={contentClass}>
						<slot />
					</div>
					{isBlogPost && (
						<nav class="post-nav" aria-label="Navigazione tra avventure">
							{next && (
								<a class="next" href={`${base}blog/${next.id}/`}>
									<span>
										<span class="eyebrow">Continua a leggere · Avventura {parseInt(next.id)} →</span>
										<strong>{nextTitle}</strong>
									</span>
									{nextCover
										? <img src={`${base}images/sessions/${nextCover}`} alt="" loading="lazy" decoding="async" />
										: next.data.heroImage && <Image src={next.data.heroImage} width={288} height={216} alt="" loading="lazy" />}
								</a>
							)}
							<div class="secondary-links">
								{prev && <a class="prev" href={`${base}blog/${prev.id}/`}>← Avventura {parseInt(prev.id)}</a>}
								<a class="index" href={`${base}blog/`}>Tutte le avventure</a>
							</div>
						</nav>
					)}
				</div>
				</div>
			</article>
		</main>
		<Footer />
		{isBlogPost && (
			<dialog class="image-viewer" data-image-viewer aria-label="Immagine ingrandita">
				<div class="image-viewer__inner">
					<button class="image-viewer__close" type="button" data-image-viewer-close>Chiudi</button>
					<img class="image-viewer__image" src="" alt="" data-image-viewer-image />
					<p class="image-viewer__caption" data-image-viewer-caption></p>
				</div>
			</dialog>
		)}
		{isBlogPost && (
			<script is:inline>
				const progress = document.querySelector('[data-reading-progress]');
				const viewer = document.querySelector('[data-image-viewer]');
				const viewerImage = document.querySelector('[data-image-viewer-image]');
				const viewerCaption = document.querySelector('[data-image-viewer-caption]');
				const viewerClose = document.querySelector('[data-image-viewer-close]');
				const scrollToHash = () => {
					let id = window.location.hash.slice(1);
					try { id = decodeURIComponent(id); } catch { return; }
					if (!id) return;

					const target = document.getElementById(id);
					if (target) {
						target.scrollIntoView({ block: 'start', behavior: 'instant' });
					}
				};

				document.querySelectorAll('.article-content h2[id], .article-content h3[id]').forEach((heading) => {
					if (!(heading instanceof HTMLElement) || heading.querySelector('.section-copy-link')) return;
					if (window.getComputedStyle(heading).display === 'none') return;

					const headingText = heading.textContent?.trim() || 'sezione';
					const button = document.createElement('button');
					button.type = 'button';
					button.className = 'section-copy-link';
					button.setAttribute('aria-label', `Copia link alla sezione: ${headingText}`);

					button.addEventListener('click', async () => {
						const url = new URL(window.location.href);
						url.hash = heading.id;
						window.history.replaceState(null, '', url);

						try {
							await navigator.clipboard.writeText(url.href);
						} catch {
							// The section URL is still available in the address bar.
							return;
						}

						button.dataset.copied = 'true';
						button.setAttribute('aria-label', `Link copiato: ${headingText}`);
						window.setTimeout(() => {
							button.dataset.copied = 'false';
							button.setAttribute('aria-label', `Copia link alla sezione: ${headingText}`);
						}, 1400);
					});

					heading.append(button);
				});

				if (window.location.hash) {
					window.requestAnimationFrame(() => {
						scrollToHash();
						window.setTimeout(scrollToHash, 250);
					});
				}

				window.addEventListener('hashchange', scrollToHash);

				if (progress instanceof HTMLElement) {
					const updateProgress = () => {
						const scrollTop = window.scrollY || document.documentElement.scrollTop;
						const maxScroll = document.documentElement.scrollHeight - window.innerHeight;
						const value = maxScroll > 0 ? Math.min(100, Math.max(0, (scrollTop / maxScroll) * 100)) : 0;
						progress.style.width = `${value}%`;
					};

					updateProgress();
					window.addEventListener('scroll', updateProgress, { passive: true });
					window.addEventListener('resize', updateProgress, { passive: true });
				}

				if (
					typeof HTMLDialogElement !== 'undefined'
					&& viewer instanceof HTMLDialogElement
					&& typeof viewer.showModal === 'function'
					&& viewerImage instanceof HTMLImageElement
					&& viewerCaption instanceof HTMLElement
					&& viewerClose instanceof HTMLButtonElement
				) {
					let lastOpenedImage = null;

					const openImage = (image) => {
						const source = image.currentSrc || image.src;
						const caption = image.alt || '';

						if (!source) return;

						lastOpenedImage = image;
						viewerImage.src = source;
						viewerImage.alt = caption;
						viewerCaption.textContent = caption;

						viewer.showModal();

						viewerClose.focus();
					};

					document.querySelectorAll('.article-content img').forEach((image) => {
						if (!(image instanceof HTMLImageElement)) return;

						const label = image.alt ? `Ingrandisci immagine: ${image.alt}` : 'Ingrandisci immagine';
						image.setAttribute('role', 'button');
						image.setAttribute('tabindex', '0');
						image.setAttribute('aria-label', label);

						image.addEventListener('click', () => openImage(image));
						image.addEventListener('keydown', (event) => {
							if (event.key !== 'Enter' && event.key !== ' ') return;
							event.preventDefault();
							openImage(image);
						});
					});

					viewerClose.addEventListener('click', () => viewer.close());
					viewer.addEventListener('click', (event) => {
						if (event.target === viewer) {
							viewer.close();
						}
					});
					viewer.addEventListener('close', () => {
						viewerImage.removeAttribute('src');
						if (lastOpenedImage instanceof HTMLImageElement) {
							lastOpenedImage.focus({ preventScroll: true });
						}
						lastOpenedImage = null;
					});
				}
			</script>
		)}
	</body>
</html>
