---
import fs from 'node:fs/promises';
import path from 'node:path';
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';
import { excerptFromMarkdown } from '../../utils/seo';

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	return posts.map((post) => ({
		params: { slug: post.id },
		props: post,
	}));
}
type Props = CollectionEntry<'blog'>;

const post = Astro.props;
const { Content, headings } = await render(post);
if (!post.filePath) throw new Error(`Missing source file path for blog entry "${post.id}"`);
const source = await fs.readFile(path.resolve(post.filePath), 'utf8');
const words = source.match(/\p{L}[\p{L}\p{N}'’:-]*/gu)?.length ?? 0;
const readingMinutes = Math.max(1, Math.ceil(words / 220));
const seoDescription = excerptFromMarkdown(source);
---

<BlogPost {...post.data} description={seoDescription} postId={post.id} headings={headings} readingMinutes={readingMinutes}>
	<Content />
</BlogPost>
