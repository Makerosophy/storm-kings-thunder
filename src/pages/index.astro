---
import { Image } from 'astro:assets';
import Nightstone from '../../public/images/home/1_Nightstone.webp';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { getCollection, render } from 'astro:content';
import RisolutoriOg from '../assets/risolutori-social.webp';
import { chapterCovers } from '../utils/chapter-covers';

const posts = (await getCollection('blog'))
	.filter(({ id }) => /^\d+-avventura$/.test(id))
	.sort((a, b) => parseInt(a.id) - parseInt(b.id));

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const firstPost = posts[0];
const latestPost = posts.at(-1);

const previews = await Promise.all(
	posts.slice(-3).reverse().map(async (p) => {
		const { headings } = await render(p);
		const dateFromDesc = (p.data.description?.match(/\b\d{2}\/\d{2}\/\d{4}\b/) || [])[0];
		const dateLabel = dateFromDesc || new Date(p.data.pubDate).toLocaleDateString('it-IT');
		return {
			id: p.id,
			title: headings.find(({ depth }) => depth === 1)?.text ?? p.data.title,
			num: parseInt(p.id),
			dateLabel,
			thumb: chapterCovers[p.id] ? `${base}images/sessions/${chapterCovers[p.id]}` : '',
		};
	})
);
---

<!doctype html>
<html lang="it">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} image={RisolutoriOg} />
	</head>
	<body>
		<Header />
		<main id="content" tabindex="-1" class="container home-page">
			<section class="hero" aria-labelledby="campaign-title">
				<div class="hero-body">
					<p class="eyebrow">Il diario dei Risolutori</p>
					<h1 id="campaign-title">Storm King’s <span>Thunder</span></h1>
					<p class="hero-lead">Una cronaca illustrata della campagna, dal primo incontro a Nightstone alla crisi dei giganti.</p>
					<div class="hero-actions">
						{firstPost && <a class="button" href={`${base}blog/${firstPost.id}/`}>Inizia da Nightstone →</a>}
						{latestPost && <a class="button secondary" href={`${base}blog/${latestPost.id}/`}>Leggi l’ultima avventura</a>}
					</div>
				</div>
				<div class="hero-media">
					<Image class="hero-image" src={Nightstone} alt="" widths={[480, 768, 1024]}
						sizes="(max-width: 600px) 100vw, (max-width: 1280px) 96vw, 1280px" loading="eager" decoding="auto" fetchpriority="high" />
				</div>
			</section>

			<section class="home-section" aria-labelledby="latest-adventures">
				<div class="home-section-heading">
					<h2 id="latest-adventures">Ultime avventure</h2>
					<a href={`${base}blog/`}>Tutte le avventure →</a>
				</div>
				<div class="adventure-grid">
					{previews.map((post) => (
						<a class:list={['card', { 'has-image': post.thumb }]} href={`${base}blog/${post.id}/`}>
							{post.thumb && <img class="thumb" src={post.thumb} alt="" loading="lazy" decoding="async" />}
							<div class="card-copy">
								<span class="num">Avventura {post.num}</span>
								<h3 class="title">{post.title}</h3>
								<span class="date">{post.dateLabel}</span>
							</div>
						</a>
					))}
				</div>
			</section>

			<section class="prologue" aria-labelledby="nightstone-title">
				<div>
					<p class="prologue-date">30 Ches 1486</p>
					<h2 id="nightstone-title">Nightstone</h2>
				</div>
				<div class="prologue-copy">
					<p>Da due mesi i giganti attaccano la Frontiera Selvaggia. Fuori da Nightstone, Huldur, Krjiv, Aerendir e Kyle si incontrano per la prima volta.</p>
					<a href={`${base}about/`}>Conosci i Risolutori →</a>
				</div>
			</section>
		</main>
		<style>
			.home-page { padding: clamp(0.7rem, 3vw, 2rem) 0 4rem; }

			.hero {
				display: grid;
				isolation: isolate;
				min-height: clamp(31rem, 55vw, 44rem);
				border: 1px solid var(--night-line);
				border-radius: var(--radius);
				overflow: hidden;
				background: var(--midnight);
				box-shadow: 0 24px 70px #080f18a0;
			}

			.hero-body, .hero-media { grid-area: 1 / 1; }

			.hero-media {
				position: relative;
				margin: 0;
				align-self: stretch;
				z-index: -1;
			}

			.hero-media::after {
				position: absolute;
				inset: 0;
				content: "";
				background: linear-gradient(90deg, #0b1420 2%, #0b1420ee 28%, #0b1420b8 45%, #0b142000 77%),
					linear-gradient(0deg, #0b1420e0, transparent 32%);
			}

			.hero-image {
				position: absolute;
				inset: 0;
				width: 100%;
				height: 100%;
				object-fit: cover;
				object-position: 65% 29%;
				border-radius: 0;
			}

			.hero-body {
				align-self: center;
				padding: clamp(1.5rem, 6vw, 5rem);
				min-width: 0;
				max-width: 54rem;
			}

			.hero-body h1 {
				color: var(--moonlight);
				font-size: clamp(3rem, 2.2rem + 4.7vw, 6.7rem);
				font-weight: 400;
				letter-spacing: -0.055em;
				line-height: 0.94;
				margin-bottom: 1.35rem;
			}

			.hero-body h1 span { display: block; color: var(--gold); }
			.hero-body .eyebrow { color: var(--gold); }
			.hero-lead { max-width: 31rem; color: var(--moonlight); font-size: clamp(1.05rem, 1rem + 0.4vw, 1.3rem); }
			.hero-actions { display: flex; flex-wrap: wrap; gap: 0.65rem; }
			.hero-actions .button { min-height: 2.9rem; }
			.hero-actions .secondary { background: #101c29de; border-color: var(--night-line); color: var(--moonlight); }
			.hero-actions .secondary:hover { background: #27394b; }

			.home-section { padding-top: clamp(2.8rem, 6vw, 5rem); }
			.home-section-heading {
				display: flex;
				align-items: baseline;
				justify-content: space-between;
				flex-wrap: wrap;
				gap: 0.4rem 1rem;
				margin-bottom: 1.2rem;
			}
			.home-section-heading h2, .home-section-heading a { color: var(--moonlight); }
			.home-section-heading a:hover { color: var(--gold); }

			.adventure-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; }
			.card {
				display: grid;
				grid-template-rows: auto 1fr;
				min-width: 0;
				border: 1px solid var(--night-line);
				border-radius: var(--radius);
				overflow: hidden;
				text-decoration: none;
				background: var(--midnight-raised);
				color: var(--moonlight);
			}
			.card:hover, .card:focus-visible { color: var(--moonlight); border-color: var(--gold); }
			.card .thumb { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; border-radius: 0; }
			.card-copy { display: grid; align-content: start; gap: 0.55rem; padding: clamp(1rem, 2vw, 1.5rem); }
			.card .num { color: var(--gold); font-weight: 700; font-size: 0.85rem; }
			.card .title { color: inherit; margin: 0; font-size: clamp(1.35rem, 1.1rem + 0.8vw, 2rem); }
			.card .date { color: var(--muted-moonlight); font-size: 0.95rem; }

			.prologue {
				display: grid;
				grid-template-columns: minmax(10rem, 0.35fr) minmax(0, 1fr);
				gap: 1.2rem 2rem;
				margin-top: clamp(2.8rem, 6vw, 5rem);
				padding: clamp(1.2rem, 4vw, 2.75rem);
				border-top: 1px solid var(--night-line);
				color: var(--moonlight);
			}
			.prologue h2 { color: var(--moonlight); }
			.prologue-date { color: var(--gold); font-weight: 700; }
			.prologue-copy { max-width: 66ch; }
			.prologue-copy p:last-of-type { margin-bottom: 0.65rem; }
			.prologue-copy a { color: var(--gold); }

			@media (max-width: 850px) {
				.adventure-grid { grid-template-columns: 1fr; }
				.card.has-image { grid-template-columns: minmax(0, 0.8fr) minmax(0, 1fr); grid-template-rows: auto; }
				.card .thumb { height: 100%; }
			}

			@media (max-width: 600px) {
				.hero { min-height: 0; }
				.hero-body, .hero-media { grid-area: auto; }
				.hero-media { order: -1; aspect-ratio: 16 / 10; }
				.hero-media::after { background: linear-gradient(0deg, var(--midnight), transparent 40%); }
				.hero-body { padding-top: 0.5rem; }
				.hero-actions { display: grid; }
				.prologue { grid-template-columns: 1fr; padding-inline: 0.25rem; }
			}

			@media (max-width: 450px) {
				.card.has-image { grid-template-columns: 1fr; grid-template-rows: auto 1fr; }
				.card .thumb { height: auto; }
			}
		</style>
		<Footer />
	</body>
</html>
