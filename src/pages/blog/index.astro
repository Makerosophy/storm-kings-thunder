---
import { getCollection, render } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { chapterCovers } from '../../utils/chapter-covers';

const pageDescription = 'Indice ricercabile delle avventure di Storm King\'s Thunder: capitoli, scene e luoghi chiave del diario dei Risolutori.';
const rawPosts = (await getCollection('blog'))
	.filter(({ id }) => /^\d+-avventura$/.test(id))
	.sort((a, b) => parseInt(a.id) - parseInt(b.id));
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const totalPosts = rawPosts.length;

const posts = await Promise.all(
	rawPosts.map(async (entry) => {
		const { headings } = await render(entry);
		const mainHeading = headings.find(({ depth }) => depth === 1) ?? headings.find(({ depth }) => depth === 2);
		const sections = headings
			.filter((h) => (h.depth === 1 || h.depth === 2 || h.depth === 3) && h.slug !== mainHeading?.slug && h.text.trim() !== entry.data.title.trim())
			.map(({ depth, slug, text }) => ({
				depth,
				slug,
				text,
				isChapter: /^(?:\d+°\s*)?Capitolo\s+\d+\b|^\d+°\s*Capitolo\b/i.test(text),
			}));
		return { entry, sections, chapterTitle: mainHeading?.text ?? entry.data.title };
	})
);
const totalSections = posts.reduce((total, post) => total + post.sections.length, 0);
const latestPost = rawPosts.at(-1);
---

<!doctype html>
<html lang="it">
	<head>
		<BaseHead title="Indice delle avventure" description={pageDescription} />
		<style>
			.archive-page {
				padding: 2.2rem 0 4rem;
				max-width: 69rem;
			}
			.archive-shell {
				padding: 2rem;
				border: 1px solid rgba(var(--border), 0.45);
				border-radius: var(--radius);
				background: rgb(var(--paper));
				box-shadow: var(--box-shadow);
			}

			.archive-intro {
				display: flex;
				flex-wrap: wrap;
				align-items: end;
				justify-content: space-between;
				gap: 1.25rem;
				padding-bottom: 1.5rem;
				border-bottom: 1px solid rgba(var(--border), 0.55);
			}

			.archive-intro h1 {
				font-weight: 400;
				letter-spacing: -0.045em;
				font-size: clamp(2.45rem, 1.6rem + 4vw, 5rem);
			}

			.archive-intro p:last-child {
				max-width: 34rem;
				margin-bottom: 0;
			}

			.archive-tools {
				display: grid;
				grid-template-columns: minmax(0, 1fr) auto;
				gap: 1rem;
				align-items: center;
				margin-top: 1.5rem;
			}

			.search-field {
				display: grid;
				gap: 0.35rem;
			}

			.search-field[hidden] {
				display: none;
			}

			.search-field label {
				color: var(--accent-dark);
				font-size: 0.95rem;
				font-weight: 700;
			}

			.search-field input {
				width: 100%;
				padding: 0.95rem 1rem;
				border: 1px solid rgba(var(--border), 0.55);
				border-radius: var(--radius-sm);
				background: rgba(var(--storm-ivory-rgb), 0.86);
				color: rgb(var(--black));
				font: inherit;
			}

			.search-field input::placeholder {
				color: rgba(var(--storm-night-rgb), 0.48);
			}

			.archive-summary {
				display: flex;
				flex-wrap: wrap;
				justify-content: flex-end;
				gap: 0.6rem;
			}

			.archive-summary span,
			.archive-summary a {
				display: inline-flex;
				align-items: center;
				min-height: 2.9rem;
				padding: 0.65rem 0.9rem;
				border: 1px solid rgba(var(--border), 0.45);
				border-radius: 999px;
				background: rgba(var(--storm-ivory-rgb), 0.72);
				color: rgb(var(--gray-dark));
				text-decoration: none;
				font-weight: 700;
			}

			.archive-summary a:hover {
				color: var(--accent-dark);
				transform: translateY(-1px);
			}

			.toc {
				list-style: none;
				margin: 1.8rem 0 0;
				padding: 0;
				display: grid;
				grid-template-columns: minmax(0, 1fr);
				gap: 0.5rem;
			}

			.toc > li {
				padding: 0.7rem clamp(0.7rem, 2vw, 1.2rem);
				border: 1px solid rgba(var(--border), 0.4);
				border-radius: calc(var(--radius) - 6px);
				background: #fffdfa;
				box-shadow: 0 4px 14px #18212a0a;
			}

			.toc > li[hidden] {
				display: none;
			}

			.toc-post {
				display: flex;
				align-items: center;
				gap: 0.9rem;
				text-decoration: none;
				color: rgb(var(--black));
			}

			.toc-post .entry {
				min-width: 0;
				flex: 1;
			}

			.toc-post .cover {
				flex: 0 0 auto;
				width: clamp(3.15rem, 8vw, 6.5rem);
				aspect-ratio: 16 / 10;
				object-fit: cover;
				border-radius: 0.35rem;
			}

			.toc-post .num-text {
				font-variant-numeric: tabular-nums;
			}

			.toc-post .num-label {
				font-size: 0.62rem;
				line-height: 1;
				text-transform: uppercase;
				letter-spacing: 0.06em;
			}

			.toc-post:hover {
				color: var(--accent-dark);
			}

			.toc-post .num {
				display: inline-grid;
				place-items: center;
				align-content: center;
				gap: 0.2rem;
				width: 3.15rem;
				min-height: 3.15rem;
				border-radius: var(--radius-sm);
				background: var(--midnight-raised);
				color: var(--gold);
				font-weight: 700;
				flex: 0 0 auto;
			}

			.toc-post .title {
				display: block;
				line-height: 1.12;
				font-family: var(--display-font);
				font-size: clamp(1.2rem, 1.05rem + 0.8vw, 1.65rem);
				overflow-wrap: anywhere;
				color: rgb(var(--black));
			}

			.toc-post .count {
				display: block;
				margin-top: 0.25rem;
				font-size: 0.92rem;
				color: rgb(var(--gray));
			}

			.sections-details {
				margin-top: 0.55rem;
				border-top: 1px solid rgba(var(--border), 0.45);
			}

			.sections-details summary {
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: 0.8rem;
				padding-block: 0.6rem;
				min-height: 2.75rem;
				color: var(--accent-dark);
				cursor: pointer;
				font-weight: 700;
				list-style: none;
			}

			.sections-details summary::-webkit-details-marker {
				display: none;
			}

			.sections-details summary::after {
				content: "+";
				display: inline-grid;
				place-items: center;
				width: 1.55rem;
				height: 1.55rem;
				border-radius: 50%;
				background: rgba(var(--storm-mist-rgb), 0.16);
			}

			.sections-details[open] summary::after {
				content: "-";
			}

			.sections {
				list-style: none;
				margin: 0.8rem 0 0;
				padding: 0;
			}

			.sections li {
				margin-top: 0.75rem;
			}

			.sections li.chapter-title {
				padding-top: 0.35rem;
				border-top: 1px solid rgba(var(--border), 0.36);
			}

			.sections li.chapter-title:first-child {
				padding-top: 0;
				border-top: 0;
			}

			.sections li.chapter-title a {
				color: var(--accent-dark);
				font-family: "Iowan Old Style", "Palatino Linotype", "Book Antiqua", serif;
				font-size: 1.08rem;
				font-weight: 700;
			}

			.sections li.depth-3 {
				padding-left: 0.85rem;
				opacity: 0.92;
			}

			.sections a {
				text-decoration: none;
				color: rgb(var(--gray-dark));
			}

			.sections a:hover {
				color: var(--accent-dark);
			}

			.empty-state {
				margin: 1.5rem 0 0;
				padding: 1rem;
				border: 1px solid rgba(var(--border), 0.42);
				border-radius: var(--radius-sm);
				background: rgba(var(--storm-ivory-rgb), 0.72);
				color: rgb(var(--gray));
			}

			.sections-details[hidden],
			.sections-details summary[hidden],
			.sections li[hidden] {
				display: none;
			}

			.toc[data-filtered] .sections {
				margin: 0.5rem 0 0;
			}

			.toc[data-filtered] .sections li {
				margin: 0.35rem 0;
				padding: 0;
				border: 0;
				opacity: 1;
			}

			.toc[data-filtered] .sections a {
				display: flex;
				justify-content: space-between;
				align-items: center;
				gap: 0.75rem;
				min-height: 2.75rem;
				padding: 0.45rem 0.7rem;
				border-inline-start: 3px solid var(--accent);
				border-radius: 0 0.35rem 0.35rem 0;
				background: var(--accent-soft);
				color: var(--accent-dark);
				font-weight: 700;
			}

			.toc[data-filtered] .sections a::after {
				content: '→' / '';
			}

			.toc[data-filtered] .sections a:hover {
				text-decoration: underline;
			}

			.filter-count {
				margin: 0;
				color: var(--accent-dark);
				font-weight: 700;
			}

			.filter-count:not(:empty) {
				margin-top: 0.75rem;
			}

			.empty-state[hidden] {
				display: none;
			}

			@media (max-width: 900px) {
				.archive-tools {
					grid-template-columns: 1fr;
				}
			}

			@media (max-width: 720px) {
				.archive-page {
					padding-top: 1.5rem;
				}

				.archive-shell {
					padding: 1.2rem;
				}

				.archive-intro {
					align-items: start;
				}

				.archive-summary {
					display: grid;
					grid-template-columns: minmax(0, 1fr) auto;
				}

				.archive-summary span,
				.archive-summary a {
					justify-content: center;
					border-radius: var(--radius-sm);
					padding: 0.45rem 0.6rem;
					font-size: 0.9rem;
				}

				.toc > li {
					padding: 1rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main id="content" tabindex="-1" class="container archive-page">
			<section class="archive-shell">
				<div class="archive-intro">
					<div>
						<p class="eyebrow">Archivio</p>
						<h1>Indice delle avventure</h1>
						<p>Cerca per numero di avventura, titolo o nome della scena.</p>
					</div>
				</div>
				<div class="archive-tools" data-archive-tools>
					<div class="search-field" hidden data-search-field>
						<label for="archive-search">Cerca nell’archivio</label>
						<input id="archive-search" type="search" placeholder="Numero, titolo o scena" autocomplete="off" data-archive-search />
					</div>
					<div class="archive-summary">
						<span>{totalPosts} capitoli · {totalSections} scene in archivio</span>
						{latestPost && <a href={`${base}blog/${latestPost.id}/`}>Ultimo capitolo</a>}
					</div>
				</div>
				<p class="filter-count" data-archive-count role="status"></p>
				<ol class="toc" data-archive-list>
					{posts.map(({ entry, sections, chapterTitle }) => (
						<li data-archive-item data-number={parseInt(entry.id)} data-search={`${parseInt(entry.id)} ${entry.data.title} ${chapterTitle}`}>
							<a class="toc-post" href={`${base}blog/${entry.id}/`}>
								<span class="num"><span class="num-label">Avv.</span><span class="num-text">{String(parseInt(entry.id)).padStart(2, '0')}</span></span>
								<span class="entry">
									<span class="title">{chapterTitle}</span>
									<span class="count">{sections.length} snodi narrativi</span>
								</span>
								{chapterCovers[entry.id] && <img class="cover" src={`${base}images/sessions/${chapterCovers[entry.id]}`} alt="" loading="lazy" decoding="async" />}
							</a>
							{sections.length > 0 && (
								<details class="sections-details">
									<summary>Indice delle scene</summary>
									<ul class="sections">
										{sections.map(({ depth, slug, text, isChapter }) => (
											<li class={`depth-${depth}${isChapter ? ' chapter-title' : ''}`} data-archive-scene>
												<a href={`${base}blog/${entry.id}/#${slug}`}>{text}</a>
											</li>
										))}
									</ul>
								</details>
							)}
						</li>
					))}
				</ol>
				<p class="empty-state" hidden data-archive-empty>Nessun capitolo trovato.</p>
			</section>
		</main>
		<Footer />
		<script is:inline>
			const search = document.querySelector('[data-archive-search]');
			const list = document.querySelector('[data-archive-list]');
			const count = document.querySelector('[data-archive-count]');
			const empty = document.querySelector('[data-archive-empty]');

			if (search instanceof HTMLInputElement) {
				search.closest('[data-search-field]')?.removeAttribute('hidden');
				const normalize = (value) => value.toLocaleLowerCase('it-IT').normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/[’']/g, ' ');
				const items = Array.from(list.querySelectorAll('[data-archive-item]'), (item) => ({
					item,
					number: Number(item.dataset.number),
					text: normalize(item.dataset.search),
					details: item.querySelector('details'),
					summary: item.querySelector('summary'),
					scenes: Array.from(item.querySelectorAll('[data-archive-scene]'), (scene) => ({
						scene,
						text: normalize(scene.textContent),
					})),
					wasOpen: false,
				}));
				let wasFiltering = false;
				const update = () => {
					const query = normalize(search.value).trim().split(/\s+/).filter(Boolean);
					const filtering = query.length > 0;
					const numberQuery = query.length === 1 && /^\d+$/.test(query[0]) ? Number(query[0]) : null;
					list.toggleAttribute('data-filtered', filtering);
					let chapters = 0;
					let scenes = 0;
					for (const entry of items) {
						const matchesChapter = numberQuery === null
							? query.every((word) => entry.text.includes(word))
							: entry.number === numberQuery;
						let sceneCount = 0;
						for (const { scene, text } of entry.scenes) {
							const matchesScene = filtering && numberQuery === null && (matchesChapter
								? query.every((word) => text.includes(word))
								: query.every((word) => entry.text.includes(word) || text.includes(word)));
							scene.hidden = filtering && !matchesScene;
							if (matchesScene) sceneCount++;
						}
						entry.item.hidden = !matchesChapter && sceneCount === 0;
						if (!entry.item.hidden) chapters++;
						scenes += sceneCount;
						if (!entry.details) continue;
						if (filtering && !wasFiltering) entry.wasOpen = entry.details.open;
						entry.details.hidden = filtering && sceneCount === 0;
						entry.summary.hidden = filtering;
						if (filtering) entry.details.open = sceneCount > 0;
						else if (wasFiltering) entry.details.open = entry.wasOpen;
					}
					count.textContent = filtering
						? `${chapters} ${chapters === 1 ? 'capitolo trovato' : 'capitoli trovati'} · ${scenes} ${scenes === 1 ? 'scena corrispondente' : 'scene corrispondenti'}`
						: '';
					empty.hidden = chapters > 0;
					wasFiltering = filtering;
				};

				search.addEventListener('input', update);
				update();
			}
		</script>
	</body>
</html>
